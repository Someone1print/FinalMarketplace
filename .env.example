# Скопируйте в .env и заполните своими значениями (.env не коммитится).
POSTGRES_DB=marketplace
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432

SECRET_KEY=change-me

# Тестовые ключи из дашборда Stripe
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=

